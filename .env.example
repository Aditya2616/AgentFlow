# Which model backend the server and CLI use: local | scripted | openai | anthropic
AGENTFLOW_LLM=local
AGENTFLOW_LOCAL_MODEL=Qwen/Qwen3-0.6B
AGENTFLOW_THREADS=3

# Hosted adapters (optional, tested only against stubbed HTTP in this repo)
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
AGENTFLOW_OPENAI_MODEL=gpt-4.1-mini
ANTHROPIC_API_KEY=
AGENTFLOW_ANTHROPIC_MODEL=test-model

# Email: outbox only unless BOTH of these are set
AGENTFLOW_SMTP_URL=
AGENTFLOW_ALLOW_SEND=0

# Server: allow free-text tasks from non-localhost clients (default refuses)
AGENTFLOW_ALLOW_REMOTE_TASKS=0
